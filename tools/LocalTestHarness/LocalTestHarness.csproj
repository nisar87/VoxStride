<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev-only: runs tests/VoxStride.Tests without NuGet (for offline/sandboxed environments). CI uses real xUnit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VoxStride.Tests</AssemblyName>
    <RootNamespace>VoxStride.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS8602;CS8604</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\tests\VoxStride.Tests\**\*.cs" Exclude="..\..\tests\VoxStride.Tests\obj\**;..\..\tests\VoxStride.Tests\bin\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\VoxStride.Core\VoxStride.Core.csproj" />
    <ProjectReference Include="..\..\src\VoxStride.Providers\VoxStride.Providers.csproj" />
  </ItemGroup>
</Project>
