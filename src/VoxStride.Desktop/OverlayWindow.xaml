<Window x:Class="VoxStride.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxStride" Width="420" SizeToContent="Height" MaxHeight="420"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" FontFamily="{StaticResource UiFont}"
        AutomationProperties.Name="VoxStride assistant">
    <Border CornerRadius="14" Padding="16,14" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="{Binding StateBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.28" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Pulse" Width="12" Height="12" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Elapsed}" Margin="8,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding ProviderLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </Grid>

            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="#14808080" x:Name="TranscriptBox">
                <TextBlock TextWrapping="Wrap" FontSize="14" MaxHeight="160" AutomationProperties.Name="Live transcript">
                    <Run Text="{Binding FinalTranscript, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding InterimTranscript, Mode=OneWay}" FontStyle="Italic" Foreground="Gray" />
                </TextBlock>
            </Border>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13" MaxHeight="90" AutomationProperties.LiveSetting="Polite" />

            <Grid Margin="0,8,0,0" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                <ProgressBar Height="6" Maximum="100" Value="{Binding Progress}" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="MuteButton" Content="Mute" Style="{StaticResource PlainButton}" Margin="0,0,8,0" Click="Mute_Click" ToolTip="Ctrl+Alt+M" />
                <Button x:Name="CancelButton" Content="Stop" Style="{StaticResource PlainButton}" Margin="0,0,8,0" Click="Cancel_Click" ToolTip="Ctrl+Alt+X" />
                <Button x:Name="ProceedButton" Content="Proceed" Style="{StaticResource PrimaryButton}" Visibility="{Binding ProceedVisible}" Click="Proceed_Click" ToolTip="Or say &quot;VoxStride, execute&quot; (Ctrl+Alt+V)" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
