<Window x:Class="VoxStride.Desktop.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxStride companion" Width="360" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FF2B2540"/>
        <SolidColorBrush x:Key="Skin" Color="#FFFFE1CC"/>
        <SolidColorBrush x:Key="SkinShade" Color="#FFF5C9AE"/>
        <SolidColorBrush x:Key="Iris" Color="#FF5A3FD0"/>
        <LinearGradientBrush x:Key="Hair" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF3B2F6B" Offset="0"/>
            <GradientStop Color="#FF221B45" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Hoodie" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF7C5CFF" Offset="0"/>
            <GradientStop Color="#FF4F7BFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="19" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,1">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- speech bubble -->
            <RowDefinition Height="*"/>      <!-- character -->
            <RowDefinition Height="Auto"/>   <!-- status -->
            <RowDefinition Height="Auto"/>   <!-- bar -->
        </Grid.RowDefinitions>

        <!-- Speech bubble: what VoxStride is saying, or a yes/no question -->
        <Border x:Name="Bubble" Grid.Row="0" Margin="14,6,14,0" Padding="14,10" CornerRadius="16" Background="#F7FFFFFF"
                BorderBrush="#33000000" BorderThickness="1" Visibility="Collapsed" MaxHeight="170">
            <StackPanel>
                <TextBlock x:Name="BubbleText" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Ink}" FontFamily="Segoe UI"
                           TextTrimming="CharacterEllipsis" MaxHeight="120"/>
                <StackPanel x:Name="AskButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button x:Name="YesButton" Content="Yes" Padding="16,4" Margin="0,0,6,0" Click="Yes_Click"/>
                    <Button x:Name="NoButton" Content="No" Padding="16,4" Click="No_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The character -->
        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="10,4,10,0">
          <Grid>
            <!-- the user's own picture, used instead of the drawn character when chosen -->
            <Grid x:Name="PictureAvatar" Width="240" Height="300" Visibility="Collapsed" Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="Character_MouseDown" MouseRightButtonUp="Character_RightClick">
                <Ellipse x:Name="PictureGlow" Width="236" Height="236" VerticalAlignment="Center" Opacity="0.55" Fill="#663CE08C">
                    <Ellipse.Effect><BlurEffect Radius="18"/></Ellipse.Effect>
                </Ellipse>
                <Image x:Name="PictureImage" Stretch="Uniform" Margin="16" RenderTransformOrigin="0.5,1">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PictureTalk" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PictureBreath" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>
            <Canvas x:Name="Character" Width="240" Height="300" Background="Transparent" Cursor="SizeAll"
                    MouseLeftButtonDown="Character_MouseDown" MouseRightButtonUp="Character_RightClick">
                <!-- shadow -->
                <Ellipse Canvas.Left="60" Canvas.Top="282" Width="120" Height="14" Fill="#33000000"/>

                <Canvas x:Name="BodyRig">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="Breath" Y="0"/>
                    </Canvas.RenderTransform>

                    <!-- hoodie body -->
                    <Path Fill="{DynamicResource Hoodie}" Data="M 52,290 C 52,222 78,196 120,196 C 162,196 188,222 188,290 Z"/>
                    <Path Fill="#33FFFFFF" Data="M 96,204 C 104,236 136,236 144,204 C 136,214 104,214 96,204 Z"/>
                    <!-- hoodie strings -->
                    <Line X1="110" Y1="214" X2="106" Y2="246" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="130" Y1="214" X2="134" Y2="246" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <!-- chest badge: sound wave -->
                    <Ellipse Canvas.Left="106" Canvas.Top="252" Width="28" Height="28" Fill="#40FFFFFF"/>
                    <Path x:Name="BadgeWave" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 112,266 L 112,266 M 117,261 L 117,271 M 122,257 L 122,275 M 127,261 L 127,271 M 132,266 L 132,266"/>

                    <!-- head group (tilts) -->
                    <Canvas x:Name="Head">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="HeadTilt" Angle="0" CenterX="120" CenterY="190"/>
                        </Canvas.RenderTransform>

                        <!-- neck -->
                        <Rectangle Canvas.Left="108" Canvas.Top="172" Width="24" Height="30" Fill="{DynamicResource SkinShade}" RadiusX="8" RadiusY="8"/>
                        <!-- back hair (one of these is shown, by character) -->
                        <Path x:Name="BackHairShort" Fill="{DynamicResource Hair}" Data="M 50,110 C 46,40 194,40 190,110 L 194,168 C 180,178 60,178 46,168 Z"/>
                        <Path x:Name="BackHairLong" Fill="{DynamicResource Hair}" Visibility="Collapsed" Data="M 48,110 C 42,36 198,36 192,110 L 204,232 C 186,246 160,236 150,214 L 90,214 C 80,236 54,246 36,232 Z"/>
                        <Path x:Name="BackHairCrop" Fill="{DynamicResource Hair}" Visibility="Collapsed" Data="M 54,112 C 50,44 190,44 186,112 L 186,128 C 160,118 80,118 54,128 Z"/>
                        <Ellipse x:Name="HairBun" Canvas.Left="96" Canvas.Top="14" Width="48" Height="44" Fill="{DynamicResource Hair}" Visibility="Collapsed"/>
                        <!-- face -->
                        <Ellipse Canvas.Left="56" Canvas.Top="52" Width="128" Height="134" Fill="{DynamicResource Skin}"/>
                        <!-- ears -->
                        <Ellipse Canvas.Left="48" Canvas.Top="112" Width="18" Height="26" Fill="{DynamicResource SkinShade}"/>
                        <Ellipse Canvas.Left="174" Canvas.Top="112" Width="18" Height="26" Fill="{DynamicResource SkinShade}"/>
                        <!-- fringe -->
                        <Path x:Name="FringeBangs" Fill="{DynamicResource Hair}" Data="M 52,110 C 48,46 192,42 188,110 L 180,96 L 172,100 L 164,82 L 152,94 L 140,76 L 128,92 L 116,74 L 104,92 L 92,78 L 82,96 L 72,86 L 64,102 Z"/>
                        <Path x:Name="FringeSide" Fill="{DynamicResource Hair}" Visibility="Collapsed" Data="M 52,112 C 48,44 192,40 188,108 C 176,92 160,82 140,78 C 120,76 96,80 78,92 C 68,98 60,104 52,112 Z"/>
                        <Path x:Name="FringeSpiky" Fill="{DynamicResource Hair}" Visibility="Collapsed" Data="M 50,108 L 44,70 L 66,78 L 64,40 L 92,62 L 102,24 L 120,56 L 140,22 L 150,60 L 178,40 L 176,78 L 198,70 L 190,108 C 168,90 140,82 120,84 C 96,84 72,92 50,108 Z"/>
                        <Path x:Name="FringeCrop" Fill="{DynamicResource Hair}" Visibility="Collapsed" Data="M 56,104 C 54,52 186,48 184,104 C 160,90 80,90 56,104 Z"/>
                        <Path Fill="#40FFFFFF" Data="M 90,58 C 108,50 140,50 158,58 C 140,56 110,56 90,62 Z"/>

                        <!-- eyebrows -->
                        <Path x:Name="BrowL" Stroke="{StaticResource Ink}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 82,100 Q 94,94 106,99">
                            <Path.RenderTransform><TranslateTransform x:Name="BrowLUp" Y="0"/></Path.RenderTransform>
                        </Path>
                        <Path x:Name="BrowR" Stroke="{StaticResource Ink}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 134,99 Q 146,94 158,100">
                            <Path.RenderTransform><TranslateTransform x:Name="BrowRUp" Y="0"/></Path.RenderTransform>
                        </Path>

                        <!-- eyes -->
                        <Canvas x:Name="EyeL" Canvas.Left="80" Canvas.Top="104">
                            <Canvas.RenderTransform><ScaleTransform x:Name="BlinkL" ScaleY="1" CenterY="14"/></Canvas.RenderTransform>
                            <Ellipse Width="26" Height="28" Fill="White"/>
                            <Canvas x:Name="PupilL">
                                <Canvas.RenderTransform><TranslateTransform x:Name="LookL"/></Canvas.RenderTransform>
                                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="17" Height="19" Fill="{DynamicResource Iris}"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="9" Height="11" Fill="{StaticResource Ink}"/>
                                <Ellipse Canvas.Left="14" Canvas.Top="8" Width="5" Height="5" Fill="White"/>
                            </Canvas>
                        </Canvas>
                        <Canvas x:Name="EyeR" Canvas.Left="134" Canvas.Top="104">
                            <Canvas.RenderTransform><ScaleTransform x:Name="BlinkR" ScaleY="1" CenterY="14"/></Canvas.RenderTransform>
                            <Ellipse Width="26" Height="28" Fill="White"/>
                            <Canvas x:Name="PupilR">
                                <Canvas.RenderTransform><TranslateTransform x:Name="LookR"/></Canvas.RenderTransform>
                                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="17" Height="19" Fill="{DynamicResource Iris}"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="9" Height="11" Fill="{StaticResource Ink}"/>
                                <Ellipse Canvas.Left="14" Canvas.Top="8" Width="5" Height="5" Fill="White"/>
                            </Canvas>
                        </Canvas>

                        <!-- cheeks -->
                        <Ellipse Canvas.Left="72" Canvas.Top="138" Width="20" Height="10" Fill="#55FF8FA3"/>
                        <Ellipse Canvas.Left="148" Canvas.Top="138" Width="20" Height="10" Fill="#55FF8FA3"/>

                        <!-- optional details, by character -->
                        <Path x:Name="Beard" Fill="{DynamicResource Hair}" Visibility="Collapsed" Opacity="0.92"
                              Data="M 64,128 C 66,170 92,190 120,190 C 148,190 174,170 176,128 C 170,150 156,160 146,160 C 140,148 100,148 94,160 C 84,160 70,150 64,128 Z"/>
                        <Canvas x:Name="Freckles" Visibility="Collapsed">
                            <Ellipse Canvas.Left="76" Canvas.Top="134" Width="3" Height="3" Fill="#88A0603A"/>
                            <Ellipse Canvas.Left="84" Canvas.Top="138" Width="3" Height="3" Fill="#88A0603A"/>
                            <Ellipse Canvas.Left="80" Canvas.Top="142" Width="3" Height="3" Fill="#88A0603A"/>
                            <Ellipse Canvas.Left="154" Canvas.Top="134" Width="3" Height="3" Fill="#88A0603A"/>
                            <Ellipse Canvas.Left="162" Canvas.Top="138" Width="3" Height="3" Fill="#88A0603A"/>
                            <Ellipse Canvas.Left="158" Canvas.Top="142" Width="3" Height="3" Fill="#88A0603A"/>
                        </Canvas>

                        <!-- mouth: a smile when quiet, opens with the voice -->
                        <Path x:Name="Smile" Stroke="{StaticResource Ink}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 108,152 Q 120,162 132,152"/>
                        <Ellipse x:Name="MouthOpen" Canvas.Left="110" Canvas.Top="150" Width="20" Height="4" Fill="#FF7A2E3A" Visibility="Collapsed"/>

                        <Canvas x:Name="Glasses" Visibility="Collapsed">
                            <Ellipse Canvas.Left="74" Canvas.Top="100" Width="38" Height="36" Stroke="{StaticResource Ink}" StrokeThickness="3" Fill="#22FFFFFF"/>
                            <Ellipse Canvas.Left="128" Canvas.Top="100" Width="38" Height="36" Stroke="{StaticResource Ink}" StrokeThickness="3" Fill="#22FFFFFF"/>
                            <Line X1="112" Y1="116" X2="128" Y2="116" Stroke="{StaticResource Ink}" StrokeThickness="3"/>
                        </Canvas>

                        <!-- headphones (VoxStride's signature) -->
                        <Path Stroke="#FF2A2350" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 50,124 C 44,30 196,30 190,124"/>
                        <Border x:Name="CupL" Canvas.Left="36" Canvas.Top="108" Width="24" Height="40" CornerRadius="10" Background="#FF2A2350">
                            <Ellipse x:Name="LedL" Width="9" Height="9" Fill="#FF3CE08C"/>
                        </Border>
                        <Border x:Name="CupR" Canvas.Left="180" Canvas.Top="108" Width="24" Height="40" CornerRadius="10" Background="#FF2A2350">
                            <Ellipse x:Name="LedR" Width="9" Height="9" Fill="#FF3CE08C"/>
                        </Border>
                        <!-- mic boom -->
                        <Path Stroke="#FF2A2350" StrokeThickness="4" StrokeEndLineCap="Round" Data="M 192,140 C 196,168 176,176 150,168"/>
                        <Ellipse x:Name="MicTip" Canvas.Left="142" Canvas.Top="162" Width="12" Height="12" Fill="#FF2A2350"/>
                    </Canvas>

                    <!-- thinking dots -->
                    <StackPanel x:Name="ThinkDots" Canvas.Left="176" Canvas.Top="40" Orientation="Horizontal" Visibility="Collapsed">
                        <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="#FF7C5CFF" Margin="2"/>
                        <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="#FF7C5CFF" Margin="2"/>
                        <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="#FF7C5CFF" Margin="2"/>
                    </StackPanel>
                </Canvas>
            </Canvas>
          </Grid>
        </Viewbox>

        <!-- status line -->
        <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,2,0,4" Padding="10,3" CornerRadius="10" Background="#B0202030">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF3CE08C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Text="Starting…" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- the bar -->
        <!-- a cheap static shadow (no blur effect, which would be re-rendered with every animation frame) -->
        <Border Grid.Row="3" Margin="10,3,6,5" CornerRadius="26" Background="#33000000" IsHitTestVisible="False"/>
        <Border Grid.Row="3" Margin="8,0,8,8" Padding="6" CornerRadius="26" Background="#E6181828" BorderBrush="#40FFFFFF" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Left" Width="44" Height="44">
                    <Ellipse x:Name="MicRing" Width="44" Height="44" Stroke="#FF3CE08C" StrokeThickness="3" Opacity="0.4"/>
                    <Button x:Name="MicButton" Style="{StaticResource BarButton}" Background="#FF7C5CFF" Click="Mic_Click" ToolTip="Mic on — click to mute (Ctrl+Alt+M)">
                        <TextBlock x:Name="MicGlyph" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                </Grid>
                <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Background="#33FFFFFF" Click="Menu_Click" ToolTip="More">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Background="#33FFFFFF" Click="Send_Click" ToolTip="Send">
                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Grid Margin="6,0">
                    <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                             FontSize="14" FontFamily="Segoe UI" VerticalContentAlignment="Center" KeyDown="Input_KeyDown"/>
                    <TextBlock x:Name="Placeholder" Text="Just talk, or type here…" Foreground="#99FFFFFF" FontSize="14" FontFamily="Segoe UI"
                               VerticalAlignment="Center" IsHitTestVisible="False" Margin="3,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
