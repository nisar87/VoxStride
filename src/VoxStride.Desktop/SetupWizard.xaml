<Window x:Class="VoxStride.Desktop.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up VoxStride" Width="640" Height="620" MinHeight="520" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" FontFamily="{StaticResource UiFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="StepLabel" Text="Step 1 of 4" Style="{StaticResource Caption}" />
            <TextBlock x:Name="StepTitle" Text="Microphone and voice" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,0" />
            <ProgressBar x:Name="StepProgress" Height="4" Maximum="4" Value="1" Margin="0,10,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Step 1: privacy, microphone, wake word, voice -->
                <StackPanel x:Name="Step1">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="VoxStride listens only after you say &quot;Hey VoxStride&quot; or press Ctrl+Alt+V. Standby listening happens on this PC; audio is never stored. Only your instruction text is sent to the AI provider you choose, and only when a task needs it. Nothing runs until you say &quot;VoxStride, execute&quot; or press Proceed." />
                    <CheckBox x:Name="MicConsentBox" Content="Use my microphone for the wake word and dictation" IsChecked="True" Margin="0,4" />
                    <TextBlock Text="Microphone" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <ComboBox x:Name="MicBox" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Microphone" />
                    <ProgressBar x:Name="MicLevel" Height="8" Maximum="100" Width="360" HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.Name="Microphone level" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="TestSpeechButton" Content="Test speech" Style="{StaticResource PlainButton}" Margin="0,0,8,8" Click="TestSpeech_Click" />
                        <Button x:Name="TestWakeButton" Content="Test &quot;Hey VoxStride&quot;" Style="{StaticResource PlainButton}" Margin="0,0,8,8" Click="TestWake_Click" />
                        <Button Content="Test my voice" Style="{StaticResource PlainButton}" Margin="0,0,8,8" Click="TestVoice_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="Step1Result" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Step 2: AI provider -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Simple commands (drive space, opening apps, organizing and searching files, cleanup) work without any AI. For writing, browsing, questions and anything open-ended, add your own API key. Keys are stored in Windows Credential Manager, never in logs. You can skip this and add a key later." />
                    <TextBlock Text="Provider" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <ComboBox x:Name="ProviderBox" Width="280" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Skip for now (local commands only)" Tag="" IsSelected="True" />
                        <ComboBoxItem Content="Claude (Anthropic)" Tag="Claude" />
                        <ComboBoxItem Content="Gemini (Google)" Tag="Gemini" />
                        <ComboBoxItem Content="OpenAI" Tag="OpenAI" />
                    </ComboBox>
                    <TextBlock Text="API key" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <PasswordBox x:Name="KeyBox" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="API key" />
                    <Button x:Name="TestKeyButton" Content="Save and test connection" Style="{StaticResource PlainButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TestKey_Click" />
                    <TextBlock x:Name="Step2Result" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Tip: an OpenAI or Gemini key also enables cloud speech, which understands accents and mixed Urdu/English far better than the built-in Windows engine (turn it on under Voice)." />
                </StackPanel>

                <!-- Step 3: permissions -->
                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Choose what VoxStride may work with. Changes to files always show you the exact list to approve first, and nothing is ever deleted permanently by the file tools. You can change all of this later under Settings › Permissions." />
                    <TextBlock Text="Folders VoxStride may use" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <WrapPanel x:Name="FolderChecks" />
                    <TextBlock Text="Other" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <CheckBox x:Name="WakeBox" Content="Listen for &quot;Hey VoxStride&quot; (on this PC)" IsChecked="True" Margin="0,3" />
                    <CheckBox x:Name="YieldBox" Content="Release the microphone while Teams, Zoom or another app uses it" IsChecked="True" Margin="0,3" />
                    <CheckBox x:Name="ScreenBox" Content="Never take window screenshots (otherwise VoxStride asks each time it needs one)" Margin="0,3" />
                    <CheckBox x:Name="StartupBox" Content="Start VoxStride when I sign in" Margin="0,3" />
                    <CheckBox x:Name="LogTextBox" Content="Include what I say in the diagnostics log on this PC (helps fix recognition problems)" IsChecked="True" Margin="0,3" />
                </StackPanel>

                <!-- Step 4: safe demo -->
                <StackPanel x:Name="Step4" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Let's try a safe command that only reads information. Click the button, or press Ctrl+Alt+V and say &quot;How much space is left on C?&quot; then &quot;VoxStride, execute&quot;." />
                    <Button x:Name="DemoButton" Content="Try: How much space is left on C?" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Demo_Click" />
                    <TextBlock x:Name="Step4Result" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,16,0,0"
                               Text="Shortcuts: Ctrl+Alt+V talk / proceed · Ctrl+Alt+X stop · Ctrl+Alt+P pause · Ctrl+Alt+M mute. Say &quot;cancel&quot; any time while speaking." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="BackButton" Content="Back" Style="{StaticResource PlainButton}" HorizontalAlignment="Left" Click="Back_Click" IsEnabled="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="Skip setup" Style="{StaticResource PlainButton}" Margin="0,0,8,0" Click="Skip_Click" />
                <Button x:Name="NextButton" Content="Next" Style="{StaticResource PrimaryButton}" Click="Next_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
