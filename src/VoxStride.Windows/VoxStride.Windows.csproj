<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native Windows integrations via P/Invoke only (no NuGet dependencies). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>VoxStride.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoxStride.Core\VoxStride.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VoxStride.Tests.Windows" />
  </ItemGroup>
</Project>
