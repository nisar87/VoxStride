<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VoxStride.Browser</RootNamespace>
    <!-- Uses the installed Microsoft Edge (channel "msedge"); no Playwright browser download is required. -->
    <PlaywrightPlatform>win</PlaywrightPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same file ships in /extension (a test asserts they are identical). -->
    <EmbeddedResource Include="Scripts\voxstride-page.js" LogicalName="voxstride-page.js" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoxStride.Core\VoxStride.Core.csproj" />
  </ItemGroup>
</Project>
