{
  "manifest_version": 3,
  "name": "VoxStride",
  "version": "1.0.0",
  "description": "Lets the VoxStride desktop assistant read and act on your current tab, only on sites you allow.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "VoxStride" }
}
